pkgname='gvisor'
_pkgbin='runsc'
_pkgshim='containerd-shim-runsc-v1'
pkgver=20261019.0
pkgrel=1
_sha512_x86_64='bcbf431b2f9a039f6ab23bfe23986031130c0f149294978cedfd46910901deba0737d8642c848f597ed4b5c72324885db4d75ee86a1f6a90915fbe1f2f2eb915'
_sha512_aarch64='60a8239ec21ba1495633dbfa24ab4d43578066fcebef2482f9d0cd1486abbfd3c5c5face1749a31cc62b287a0a44198a0852024c7f2e5683917c7c1c342d0bbe'
pkgdesc='OCI container sandbox runtime focused on security, efficiency, and ease of use'
arch=('x86_64' 'aarch64')
url='https://gvisor.dev'
license=('Apache-2.0')
makedepends=('zstd')
provides=(
	"${pkgname%}"
)
conflicts=(
	"${pkgname%-bin}"
	"${pkgname%}"
)
source_x86_64=(
	"$pkgname-x86_64-$pkgver.tar.zstd::https://storage.googleapis.com/${pkgname%-bin}/releases/release/$pkgver/x86_64/gvisor.tar.zstd"
)
source_aarch64=(
	"$pkgname-aarch64-$pkgver.tar.zstd::https://storage.googleapis.com/${pkgname%-bin}/releases/release/$pkgver/aarch64/gvisor.tar.zstd"
)
sha512sums_x86_64=("$_sha512_x86_64")
sha512sums_aarch64=("$_sha512_aarch64")

package() {
	# runsc re-execs itself and looks for gvisor-bin/ next to its own binary,
	# so keep runsc and gvisor-bin/ together under /usr/lib/gvisor and symlink
	# the user-facing binaries into /usr/bin.
	install -dm 755 "$pkgdir/usr/lib/gvisor"
	install -Dm 755 "$srcdir/$_pkgbin" "$pkgdir/usr/lib/gvisor/$_pkgbin"
	install -Dm 755 "$srcdir/$_pkgshim" "$pkgdir/usr/lib/gvisor/$_pkgshim"

	install -dm 755 "$pkgdir/usr/lib/gvisor/gvisor-bin"
	install -m 755 "$srcdir"/gvisor-bin/* "$pkgdir/usr/lib/gvisor/gvisor-bin/"

	install -dm 755 "$pkgdir/usr/bin"
	ln -s "/usr/lib/gvisor/$_pkgbin" "$pkgdir/usr/bin/$_pkgbin"
	ln -s "/usr/lib/gvisor/$_pkgshim" "$pkgdir/usr/bin/$_pkgshim"
}
